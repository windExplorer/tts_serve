# 后端选择：qwen3 | cosyvoice3
MODEL_BACKEND=qwen3
HOST=127.0.0.1
# 对外端口：浏览器和 AstrBot 插件访问的端口（改这里即可，启动脚本无需动）
PORT=50001
# 内部 worker 端口：网关转发用，对外不可见；一般不用改，三者不能相同
QWEN_WORKER_PORT=51001
COSY_WORKER_PORT=51002
LANGUAGE=Chinese

# warmup 失败时的兜底采样率；正常由后端 warmup 覆盖
SAMPLE_RATE_FALLBACK=24000

# 音色目录（voices.json + 参考音频）
VOICES_DIR=voices
DEFAULT_VOICE=

# Qwen3-TTS-12Hz-0.6B-Base
QWEN3_MODEL_DIR=models/Qwen3-TTS-12Hz-0.6B-Base
QWEN3_DEVICE=cuda:0
QWEN3_DTYPE=bfloat16
QWEN3_ATTN=sdpa

# CosyVoice3（相对 COSYVOICE_ROOT 解析模型目录）
COSYVOICE_ROOT=d:/AI/CosyVocie/CosyVoice
COSYVOICE_MODEL_DIR=pretrained_models/Fun-CosyVoice3-0.5B-2512

# ── 推理超时 ──
INFER_TIMEOUT=180

# ── 显存管理 ──
# 空闲多少秒后把权重搬回 CPU 释放显存；0=关闭自动卸载。建议 300（5分钟）
IDLE_UNLOAD_SEC=300
# 空闲显存低于此值(MB)视为被其它程序挤占，触发卸载。安全门槛=此值*3 与 2048 取大
LOW_VRAM_MB=1024
# 后台巡检间隔(秒)，支持小数
VRAM_CHECK_SEC=5
# 权重搬运(GPU<->CPU)超时秒数，防止显存被挤占时 .to(cuda) 卡死
LOAD_TIMEOUT=60
# 显存不足时是否禁止 CPU 回退：1=直接返回503，0=CPU慢跑兜底
NO_CPU_FALLBACK=0

# 说明：
# - 复制本文件为 .env 后修改生效；同名环境变量优先级高于 .env。
# - 运行时可调用 POST /api/vram/unload 手动释放显存给 ComfyUI 等，
#   POST /api/vram/load 重新载入 GPU；GET /api/status 查看当前设备/空闲显存。
